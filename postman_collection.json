        {
          "name": "Update Task Status (Triggers RabbitMQ Event)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "http://localhost:5002/tasks/{{task_id}}/status",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5002",
              "path": [
                "tasks",
                "{{task_id}}",
                "status"
              ]
            },
            "description": "Changes the status of a task and asynchronously publishes a status_changed event to RabbitMQ."
          },
          "response": []
        }
      ]
