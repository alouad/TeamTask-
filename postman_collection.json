    {
      "name": "Task Service (Port 5002)",
      "item": [
        {
          "name": "Create a Task (Manager Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{manager_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement RabbitMQ Flow\",\n  \"description\": \"Write publisher in task service and consumer in history service\",\n  \"projectId\": \"proj-999\",\n  \"assignedUser\": \"member@teamtask.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:5002/tasks",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5002",
              "path": [
                "tasks"
              ]
            },
            "description": "Creates a task. Requires a Manager JWT token. Communicates with Project Service (port 5001) for validation."
          },
          "response": []
        },
        {
          "name": "Get All Tasks (Managers & Members)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5002/tasks",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5002",
              "path": [
                "tasks"
              ]
            }
          },
          "response": []
